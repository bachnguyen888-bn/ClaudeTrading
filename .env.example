# Copy this file to .env and edit it:   cp .env.example .env
# .env is listed in .gitignore, so your real values never get committed.
#
# NEVER put a wallet private key, seed phrase, or exchange TRADING key in
# here. This project is paper-only and never needs them. The program refuses
# to start if it finds a variable whose name contains PRIVATE_KEY, MNEMONIC,
# SEED_PHRASE or WALLET.

# Must be "paper". Any other value makes every command refuse to run.
TRADING_MODE=paper

# Optional: a READ-ONLY market-data API key, for a data source you add
# yourself later. The built-in downloads (Coinbase and Kraken public
# candles) need no key at all.
DATA_API_KEY=
